# Midday environment reference.
#
# This file is the single source of truth for configuration shared across the
# monorepo. Each app/package has its own `.env.schema` that imports the keys it
# needs from here (`@import(../../, pick=[...])`), and varlock validates them at
# startup (`varlock run -- <cmd>`, `varlock load --path <dir>`).
#
# Local development: put values in a gitignored `.env` (or `.env.local`) next
# to this file. Tests load `.env.test` (APP_ENV=test).
#
# Every optional service is enabled by the presence of its keys; see
# packages/features for how presence maps to features.
#
# Tags: #core #db #redis #auth #storage #mail #ai #banking #integrations
#       #observability #jobs
#
# @defaultRequired=infer
# @defaultSensitive=false
# @currentEnv=$APP_ENV
# ---

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Node runtime mode. Usually set by the runtime/tooling (Next.js, Docker image).
# @tag(core) @type=enum(development, test, production)
NODE_ENV=

# Deployment environment; selects `.env.<APP_ENV>` overrides. Defaults to
# NODE_ENV, then `development`. Production enables scheduled maintenance jobs.
# @tag(core) @type=enum(development, test, staging, production)
APP_ENV=fallback($NODE_ENV, development)

# Public URL of the dashboard, e.g. https://app.example.com
# @tag(core) @type=url @required @example="http://localhost:3001"
APP_URL=

# Public URL of the API, e.g. https://api.example.com
# @tag(core) @type=url @required @example="http://localhost:3003"
API_URL=

# URL the dashboard server uses to reach the API (e.g. a private network
# address). Defaults to API_URL.
# @tag(core) @type=url
API_INTERNAL_URL=$API_URL

# Comma-separated extra origins allowed by API CORS (APP_URL is always allowed).
# @tag(core)
ALLOWED_API_ORIGINS=

# Deep-link scheme registered by the desktop app (midday, midday-dev, ...).
# @tag(core)
DESKTOP_SCHEME=midday

# 32-byte hex key (64 chars) used to encrypt OAuth tokens and other secrets at
# rest. Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive @type=string(minLength=64, maxLength=64)
MIDDAY_ENCRYPTION_KEY=

# Secret used to sign file access keys. Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive
FILE_KEY_SECRET=

# Secret used to sign public invoice links. Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive
INVOICE_JWT_SECRET=

# Shared key for service-to-service calls (worker/dashboard -> API).
# Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string (primary).
# @tag(db) @required @sensitive @type=url @example="postgres://postgres:postgres@localhost:5432/midday"
DATABASE_URL=

# Optional comma-separated read replica connection strings.
# @tag(db) @sensitive
DATABASE_REPLICA_URLS=

# Use TLS for database connections (hosted Postgres). `sslmode` in the URL
# also works.
# @tag(db) @type=boolean
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Redis / Valkey
# ---------------------------------------------------------------------------

# Redis connection string used for caching and bot state.
# @tag(redis) @required @sensitive @type=url @example="redis://localhost:6379"
REDIS_URL=

# Redis connection string used by BullMQ queues. Defaults to REDIS_URL.
# @tag(redis) @sensitive @type=url
REDIS_QUEUE_URL=$REDIS_URL

# ---------------------------------------------------------------------------
# Auth (Supabase) -- deprecated: removed by S1 (better-auth)
# ---------------------------------------------------------------------------

# Supabase project URL (auth, storage, realtime).
# deprecated: removed by S1/S2
# @tag(auth, storage) @type=url
SUPABASE_URL=

# Supabase publishable (anon) key, sent to browsers.
# deprecated: removed by S1/S2
# @tag(auth, storage)
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret (service role) key.
# deprecated: removed by S1/S2
# @tag(auth, storage) @sensitive
SUPABASE_SECRET_KEY=

# Legacy HS256 JWT secret fallback for Supabase access tokens.
# deprecated: removed by S1
# @tag(auth) @sensitive
SUPABASE_JWT_SECRET=

# Secret for the Supabase "user registered" database webhook.
# deprecated: removed by S1
# @tag(auth) @sensitive
WEBHOOK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Cloudflare R2 bucket for institution logos.
# deprecated: removed by S2 (storage driver)
# @tag(storage) @type=url
R2_ENDPOINT=
# deprecated: removed by S2
# @tag(storage) @sensitive
R2_ACCESS_KEY_ID=
# deprecated: removed by S2
# @tag(storage) @sensitive
R2_SECRET_ACCESS_KEY=
# deprecated: removed by S2
# @tag(storage)
R2_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

# SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465.
# Consumed by the mailer introduced in S5; without any mail provider, emails
# are logged to the console.
# @tag(mail) @sensitive @type=url
SMTP_URL=

# Resend API key.
# deprecated: removed by S5 (SMTP mailer)
# @tag(mail) @sensitive
RESEND_API_KEY=

# Basic-auth credentials for the inbound email (Postmark) webhook. Both must be
# set to enable inbound email.
# @tag(mail)
INBOX_WEBHOOK_USERNAME=
# @tag(mail) @sensitive
INBOX_WEBHOOK_PASSWORD=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# OpenAI API key (chat, insights).
# @tag(ai) @sensitive
OPENAI_API_KEY=

# Google Gemini API key (extraction, embeddings, classification).
# @tag(ai) @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral API key (OCR fallback).
# @tag(ai) @sensitive
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Banking providers (each enabled when its keys are present)
# ---------------------------------------------------------------------------

# @tag(banking) @docs(https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
# @tag(banking) @sensitive
PLAID_SECRET=
# Plaid environment, used by the API and Plaid Link in the browser.
# @tag(banking) @type=enum(sandbox, development, production)
PLAID_ENVIRONMENT=production

# @tag(banking)
GOCARDLESS_SECRET_ID=
# @tag(banking) @sensitive
GOCARDLESS_SECRET_KEY=

# @tag(banking)
ENABLEBANKING_APPLICATION_ID=
# PEM private key for the Enable Banking application.
# @tag(banking) @sensitive
ENABLE_BANKING_KEY_CONTENT=
# @tag(banking) @type=url
ENABLEBANKING_REDIRECT_URL=

# Teller application id (used by Teller Connect in the browser).
# @tag(banking)
TELLER_APPLICATION_ID=
# @tag(banking) @type=enum(sandbox, development, production)
TELLER_ENVIRONMENT=
# Base64-encoded Teller client certificate and key.
# @tag(banking) @sensitive
TELLER_CERT_BASE64=
# @tag(banking) @sensitive
TELLER_KEY_BASE64=
# @tag(banking) @sensitive
TELLER_SIGNING_SECRET=

# logo.dev token used for institution logo fallbacks.
# @tag(banking) @sensitive
LOGO_DEV_TOKEN=

# ---------------------------------------------------------------------------
# Integrations (each enabled when its keys are present)
# ---------------------------------------------------------------------------

# @tag(integrations)
SLACK_CLIENT_ID=
# @tag(integrations) @sensitive
SLACK_CLIENT_SECRET=
# @tag(integrations) @sensitive
SLACK_SIGNING_SECRET=
# @tag(integrations) @sensitive
SLACK_STATE_SECRET=
# Optional key for encrypting multi-workspace Slack installations.
# @tag(integrations) @sensitive
SLACK_ENCRYPTION_KEY=
# @tag(integrations) @type=url
SLACK_OAUTH_REDIRECT_URL=

# @tag(integrations)
XERO_CLIENT_ID=
# @tag(integrations) @sensitive
XERO_CLIENT_SECRET=
# @tag(integrations) @type=url
XERO_OAUTH_REDIRECT_URL=

# @tag(integrations)
QUICKBOOKS_CLIENT_ID=
# @tag(integrations) @sensitive
QUICKBOOKS_CLIENT_SECRET=
# @tag(integrations) @type=url
QUICKBOOKS_OAUTH_REDIRECT_URL=

# @tag(integrations)
FORTNOX_CLIENT_ID=
# @tag(integrations) @sensitive
FORTNOX_CLIENT_SECRET=
# @tag(integrations) @type=url
FORTNOX_OAUTH_REDIRECT_URL=

# @tag(integrations)
GMAIL_CLIENT_ID=
# @tag(integrations) @sensitive
GMAIL_CLIENT_SECRET=
# @tag(integrations) @type=url
GMAIL_REDIRECT_URI=

# @tag(integrations)
OUTLOOK_CLIENT_ID=
# @tag(integrations) @sensitive
OUTLOOK_CLIENT_SECRET=
# @tag(integrations) @type=url
OUTLOOK_REDIRECT_URI=

# Composio API key (AI tool connectors).
# @tag(integrations) @sensitive
COMPOSIO_API_KEY=

# Stripe Connect (invoice payments).
# @tag(integrations) @sensitive
STRIPE_SECRET_KEY=
# @tag(integrations)
STRIPE_PUBLISHABLE_KEY=
# @tag(integrations)
STRIPE_CONNECT_CLIENT_ID=
# @tag(integrations) @sensitive
STRIPE_CONNECT_WEBHOOK_SECRET=

# WhatsApp Cloud API (inbox + notifications).
# @tag(integrations)
WHATSAPP_PHONE_NUMBER_ID=
# Public WhatsApp number shown in the connect flow.
# @tag(integrations)
WHATSAPP_NUMBER=
# @tag(integrations) @sensitive
WHATSAPP_ACCESS_TOKEN=
# @tag(integrations) @sensitive
WHATSAPP_VERIFY_TOKEN=
# @tag(integrations) @sensitive
WHATSAPP_APP_SECRET=

# Telegram bot.
# @tag(integrations) @sensitive
TELEGRAM_BOT_TOKEN=
# @tag(integrations)
TELEGRAM_BOT_USERNAME=
# @tag(integrations) @sensitive
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Self-hosted Telegram Bot API gateway.
# @tag(integrations) @type=url
TELEGRAM_API_BASE_URL=

# Sendblue (iMessage/SMS).
# @tag(integrations) @sensitive
SENDBLUE_API_KEY=
# @tag(integrations) @sensitive
SENDBLUE_API_SECRET=
# Sending number, also shown in the connect flow.
# @tag(integrations)
SENDBLUE_FROM_NUMBER=
# @tag(integrations) @sensitive
SENDBLUE_WEBHOOK_SECRET=
# @tag(integrations) @type=url
SENDBLUE_STATUS_CALLBACK_URL=

# Google Maps Places key for address autocomplete (sent to browsers).
# @tag(integrations)
GOOGLE_MAPS_API_KEY=

# Exa search API key (AI web research).
# @tag(integrations) @sensitive
EXA_API_KEY=

# CompanyEnrich API key (customer enrichment).
# @tag(integrations) @sensitive
COMPANY_ENRICH_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Sentry DSN; error reporting is disabled when unset.
# @tag(observability) @type=url
SENTRY_DSN=

# OpenPanel analytics; disabled unless both are set.
# @tag(observability)
OPENPANEL_CLIENT_ID=
# @tag(observability) @sensitive
OPENPANEL_SECRET_KEY=

# @tag(observability) @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Pretty-print logs (development).
# @tag(observability) @type=boolean
LOG_PRETTY=false

# Release identifier reported to Sentry, stamped at image build time.
# @tag(observability)
GIT_COMMIT_SHA=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------

# Trigger.dev secret key.
# deprecated: removed by S3 (BullMQ)
# @tag(jobs) @sensitive
TRIGGER_SECRET_KEY=
