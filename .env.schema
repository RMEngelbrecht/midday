# Midday environment reference.
#
# This file is the single source of truth for configuration shared across the
# monorepo. Each app/package has its own `.env.schema` that imports the keys it
# needs from here (`@import(../../, pick=[...])`), and varlock validates them at
# startup (`varlock run -- <cmd>`, `varlock load --path <dir>`).
#
# Local development: put values in a gitignored `.env` (or `.env.local`) next
# to this file. Tests load `.env.test` (APP_ENV=test).
#
# Every optional service is enabled by the presence of its keys; see
# packages/features for how presence maps to features.
#
# Tags: #core #db #redis #auth #storage #mail #ai #banking #integrations
#       #observability
#
# @defaultRequired=infer
# @defaultSensitive=false
# @currentEnv=$APP_ENV
# ---

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Node runtime mode. Usually set by the runtime/tooling (Next.js, Docker image).
# @tag(core) @type=enum(development, test, production)
NODE_ENV=

# Deployment environment; selects `.env.<APP_ENV>` overrides. Defaults to
# NODE_ENV, then `development`. Production enables scheduled maintenance jobs.
# @tag(core) @type=enum(development, test, staging, production)
APP_ENV=fallback($NODE_ENV, development)

# Public URL of the dashboard, e.g. https://app.example.com
# @tag(core) @type=url @required @example="http://localhost:3001"
APP_URL=

# Public URL of the API, e.g. https://api.example.com
# @tag(core) @type=url @required @example="http://localhost:3003"
API_URL=

# Fallback country (ISO 3166 alpha-2, e.g. SE) when neither Cloudflare geo
# headers nor Accept-Language identify one.
# @tag(core)
DEFAULT_COUNTRY=

# Fallback IANA timezone (e.g. Europe/Berlin) when the request has no timezone
# header and the user/team has none set.
# @tag(core)
DEFAULT_TIMEZONE=

# URL the dashboard server uses to reach the API (e.g. a private network
# address). Defaults to API_URL.
# @tag(core) @type=url
API_INTERNAL_URL=$API_URL

# Comma-separated extra origins allowed by API CORS (APP_URL is always allowed).
# @tag(core)
ALLOWED_API_ORIGINS=

# Deep-link scheme registered by the desktop app (midday, midday-dev, ...).
# @tag(core)
DESKTOP_SCHEME=midday

# 32-byte hex key (64 chars) used to encrypt OAuth tokens and other secrets at
# rest. Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive @type=string(minLength=64, maxLength=64)
MIDDAY_ENCRYPTION_KEY=

# Secret used to sign file access keys. Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive
FILE_KEY_SECRET=

# Secret used to sign public invoice links. Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive
INVOICE_JWT_SECRET=

# Shared key for service-to-service calls (worker/dashboard -> API).
# Generate with `openssl rand -hex 32`.
# @tag(core) @required @sensitive
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string (primary).
# @tag(db) @required @sensitive @type=url @example="postgres://postgres:postgres@localhost:5432/midday"
DATABASE_URL=

# Optional comma-separated read replica connection strings.
# @tag(db) @sensitive
DATABASE_REPLICA_URLS=

# Use TLS for database connections (hosted Postgres). `sslmode` in the URL
# also works.
# @tag(db) @type=boolean
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Redis / Valkey
# ---------------------------------------------------------------------------

# Redis connection string used for caching and bot state.
# @tag(redis) @required @sensitive @type=url @example="redis://localhost:6379"
REDIS_URL=

# Redis connection string used by BullMQ queues. Defaults to REDIS_URL.
# @tag(redis) @sensitive @type=url
REDIS_QUEUE_URL=$REDIS_URL

# ---------------------------------------------------------------------------
# Auth (Supabase) -- deprecated: removed by S1 (better-auth)
# ---------------------------------------------------------------------------

# Supabase project URL (auth, realtime).
# deprecated: removed by S1; dashboard realtime still uses it
# @tag(auth) @type=url
SUPABASE_URL=

# Supabase publishable (anon) key, sent to browsers.
# deprecated: removed by S1; dashboard realtime still uses it
# @tag(auth)
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret (service role) key.
# deprecated: removed by S1
# @tag(auth) @sensitive
SUPABASE_SECRET_KEY=

# Legacy HS256 JWT secret fallback for Supabase access tokens.
# deprecated: removed by S1
# @tag(auth) @sensitive
SUPABASE_JWT_SECRET=

# Secret for the Supabase "user registered" database webhook.
# deprecated: removed by S1
# @tag(auth) @sensitive
WEBHOOK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where files live: `local` (a directory, the default) or `s3` (any
# S3-compatible store: AWS, R2, Garage, MinIO). Inferred as `s3` when
# S3_BUCKET is set. Buckets (vault, avatars, apps, institutions) are key
# prefixes inside the one store.
# @tag(storage) @type=enum(local, s3)
STORAGE_DRIVER=

# Directory for the local driver. Relative paths resolve against the repo root,
# so the API and worker share it in development. Mount a volume here in Docker.
# @tag(storage)
STORAGE_LOCAL_DIR=./data/storage

# Largest file accepted by POST /files/upload, in megabytes.
# @tag(storage) @type=number
STORAGE_MAX_UPLOAD_MB=100

# S3 API endpoint. Leave empty for AWS; set for R2/Garage/MinIO,
# e.g. https://<account>.r2.cloudflarestorage.com or http://garage:3900
# @tag(storage) @type=url
S3_ENDPOINT=
# @tag(storage)
S3_REGION=us-east-1
# Bucket holding every Midday object. Setting it selects the s3 driver.
# @tag(storage)
S3_BUCKET=
# @tag(storage) @sensitive
S3_ACCESS_KEY_ID=
# @tag(storage) @sensitive
S3_SECRET_ACCESS_KEY=
# Path-style addressing (http://host/bucket/key). Needed for Garage and MinIO.
# @tag(storage) @type=boolean
S3_FORCE_PATH_STYLE=false
# Endpoint browsers can reach for presigned URLs. When unset, signed URLs are
# served through the API (use this when S3_ENDPOINT is a private address).
# @tag(storage) @type=url
S3_PUBLIC_ENDPOINT=
# Public base URL of the bucket (e.g. an R2 custom domain) used for public
# objects (avatars, app logos, institution logos). When unset, they are served
# by the API at /files/public/<key>.
# @tag(storage) @type=url
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
#
# Outbound mail goes through SMTP (nodemailer). Without SMTP_URL, emails (OTP
# codes, invites, invoices, notifications) are logged to the console instead.
#
# SMTP_URL examples (use smtps:// for implicit TLS on 465, smtp:// for
# STARTTLS on 587; URL-encode special characters in the password):
#   Resend    smtps://resend:re_xxxxxxxx@smtp.resend.com:465
#   Postmark  smtp://<server-token>:<server-token>@smtp.postmarkapp.com:587
#   SES       smtp://<smtp-user>:<smtp-pass>@email-smtp.<region>.amazonaws.com:587
#   Mailgun   smtp://postmaster@mg.example.com:<password>@smtp.mailgun.org:587
#   Mailpit   smtp://localhost:1025 (local testing)
# The sender domain must be verified with your provider.

# SMTP connection string, see examples above.
# @tag(mail) @sensitive @type=url
SMTP_URL=

# Default From address, e.g. "Midday <noreply@example.com>". Defaults to
# noreply@ the host of APP_URL.
# @tag(mail)
MAIL_FROM=

# Inbound email (forward receipts and invoices to a per-team address).
# Addresses look like <inboxId>@INBOX_EMAIL_DOMAIN, or
# INBOX_EMAIL_LOCAL_PART+<inboxId>@INBOX_EMAIL_DOMAIN when a local part is set
# (plus-addressing, for a single shared mailbox).
# @tag(mail)
INBOX_EMAIL_DOMAIN=
# @tag(mail)
INBOX_EMAIL_LOCAL_PART=

# Inbound via IMAP polling (worker). Any IMAP mailbox works, e.g.
# imaps://user:pass@imap.example.com:993. Messages are matched to a team by
# recipient (To, Delivered-To, X-Original-To).
# @tag(mail) @sensitive @type=url
IMAP_URL=
# @tag(mail)
IMAP_MAILBOX=INBOX
# Mailbox processed messages are moved to. Empty: only mark them as seen.
# @tag(mail)
IMAP_PROCESSED_MAILBOX=
# Minutes between polls.
# @tag(mail) @type=number
IMAP_POLL_INTERVAL=5

# Basic-auth credentials for the optional inbound email (Postmark) webhook at
# /webhooks/inbox. Both must be set to enable it.
# @tag(mail)
INBOX_WEBHOOK_USERNAME=
# @tag(mail) @sensitive
INBOX_WEBHOOK_PASSWORD=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# OpenAI API key (chat, insights).
# @tag(ai) @sensitive
OPENAI_API_KEY=

# Google Gemini API key (extraction, embeddings, classification).
# @tag(ai) @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral API key (OCR fallback).
# @tag(ai) @sensitive
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Banking providers (each enabled when its keys are present)
# ---------------------------------------------------------------------------

# Plaid: the free Trial plan includes 10 production Items.
# @tag(banking) @docs(https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
# @tag(banking) @sensitive
PLAID_SECRET=
# Plaid environment, used by the API and Plaid Link in the browser.
# @tag(banking) @type=enum(sandbox, development, production)
PLAID_ENVIRONMENT=production

# Self-hosting notes. No bank-data aggregator can itself be self-hosted: pulling
# bank data requires a licensed intermediary. Options, cheapest first:
#   - Statement import (OFX/QFX, CAMT.053, MT940, QIF, CSV): free, no keys.
#   - SimpleFIN Bridge (US/CA): about $15-25/year, no developer account.
#   - Enable Banking (EU/UK): "restricted production" mode is free for linking
#     your OWN accounts, non-commercial use only. Companies need a contract.
#   - Plaid (US/CA): the free Trial plan allows 10 production Items.
#   - Teller (US): the free development tier allows a small number of live
#     enrollments (check current limits).
# Every provider except SimpleFIN needs your own developer account and keys.

# Enable SimpleFIN Bridge (US/CA, https://www.simplefin.org). Users paste a
# setup token from their bridge account (about $15-25/year, billed by SimpleFIN);
# no server-side keys are needed.
# @tag(banking) @type=boolean
SIMPLEFIN_ENABLED=false

# Enable Banking (EU/UK). Create an app at https://enablebanking.com/cp/applications
# and use restricted production mode to link your own accounts for free.
# @tag(banking)
ENABLEBANKING_APPLICATION_ID=
# PEM private key for the Enable Banking application.
# @tag(banking) @sensitive
ENABLE_BANKING_KEY_CONTENT=
# Defaults to $APP_URL/api/enablebanking/session when unset.
# @tag(banking) @type=url
ENABLEBANKING_REDIRECT_URL=

# Teller application id (used by Teller Connect in the browser).
# @tag(banking)
TELLER_APPLICATION_ID=
# @tag(banking) @type=enum(sandbox, development, production)
TELLER_ENVIRONMENT=
# Base64-encoded Teller client certificate and key.
# @tag(banking) @sensitive
TELLER_CERT_BASE64=
# @tag(banking) @sensitive
TELLER_KEY_BASE64=
# @tag(banking) @sensitive
TELLER_SIGNING_SECRET=

# logo.dev publishable token used for institution/company logos. Optional:
# without it, logos fall back to initials avatars.
# @tag(banking) @tag(integrations)
LOGO_DEV_TOKEN=

# Base URL of the exchange-rates dataset (fawazahmed0 currency-api layout).
# @tag(banking) @type=url
EXCHANGE_RATES_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1

