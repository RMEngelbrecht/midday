# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Sentry DSN; error reporting is disabled when unset.
# @tag(observability) @type=url
SENTRY_DSN=

# OpenPanel analytics; disabled unless both are set.
# @tag(observability)
OPENPANEL_CLIENT_ID=
# @tag(observability) @sensitive
OPENPANEL_SECRET_KEY=

# @tag(observability) @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Pretty-print logs (development).
# @tag(observability) @type=boolean
LOG_PRETTY=false

# Release identifier reported to Sentry, stamped at image build time.
# @tag(observability)
GIT_COMMIT_SHA=
