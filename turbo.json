{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [".env.schema", ".env.test"],
  "ui": "stream",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        ".expo/**",
        "dist/**",
        "build/**",
        "lib/**"
      ],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "GIT_COMMIT_SHA",
        "GITHUB_TOKEN"
      ]
    },
    "start": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test": {
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "jobs": {
      "persistent": true,
      "cache": false
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "lint:fix": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "typecheck": {
      "outputs": []
    }
  }
}
