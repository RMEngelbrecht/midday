{
  "name": "@midday/location",
  "version": "1.0.0",
  "main": "src/index.ts",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "APP_ENV=test varlock run -- bun test src"
  },
  "exports": {
    ".": "./src/index.ts",
    "./countries": "./src/countries.ts",
    "./countries-intl": "./src/countries-intl.ts",
    "./currencies": "./src/currencies.ts",
    "./country-flags": "./src/country-flags.ts",
    "./resolve": "./src/resolve.ts",
    "./timezones": "./src/timezones.ts"
  },
  "dependencies": {
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "catalog:"
  }
}
