# Env for @midday/db. Shared keys are documented in the root .env.schema.
# Imports mirror the workspace dependencies that read env (keep in sync with package.json).
#
# @import(../../, pick=[NODE_ENV, APP_ENV, DATABASE_REPLICA_URLS, DATABASE_SSL, DATABASE_URL])
# @import(../banking/.env.schema)
# @import(../categories/.env.schema)
# @import(../storage/.env.schema)
# @import(../encryption/.env.schema)
# @import(../invoice/.env.schema)
# @import(../logger/.env.schema)
# @import(../utils/.env.schema)
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Max connections in the main (api) pool. Defaults to 8 in development, 20
# otherwise.
# @type=number
DATABASE_POOL_MAX=

# Log pg pool connect/acquire/remove events.
# @type=boolean
DB_POOL_EVENT_LOGGING=false

# Log per-request DB timing (also used by apps/api middleware).
# @type=boolean
DEBUG_PERF=false

# Auto-match inbox items to transactions above the confidence threshold.
# @type=boolean
MATCH_AUTO_ENABLED=false

# Postgres used by DB integration tests (skipped when unset).
# @sensitive @type=url
TEST_DATABASE_URL=
