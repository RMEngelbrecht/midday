{
  "name": "@midday/db",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "varlock run -- bun run src/scripts/migrate.ts",
    "db:generate": "drizzle-kit generate && biome format --write migrations/meta",
    "test": "APP_ENV=test varlock run -- bun test --exit",
    "eval:matching:db": "varlock run -- bun run src/scripts/matching-eval-db.ts",
    "eval:progress": "varlock run -- bun run src/scripts/matching-progress.ts",
    "eval:similar": "varlock run -- bun run src/scripts/eval-similar-transactions.ts",
    "test:matching": "APP_ENV=test varlock run -- bun test src/test/transaction-matching.test.ts",
    "test:performance": "APP_ENV=test varlock run -- bun test src/test/transaction-matching.performance.test.ts",
    "test:integration": "APP_ENV=test varlock run -- bun test src/test/transaction-matching.integration.test.ts",
    "test:golden": "APP_ENV=test varlock run -- bun test src/test/transaction-matching.golden.test.ts",
    "test:all-matching": "APP_ENV=test varlock run -- bun test src/test/transaction-matching*.test.ts",
    "test:reports": "APP_ENV=test varlock run -- bun test src/test/reports.test.ts",
    "test:e2e": "APP_ENV=test varlock run -- bun test src/test/calculations-e2e.test.ts --exit --timeout 30000",
    "test:e2e:setup": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/midday_test} APP_ENV=test varlock run -- bun run src/scripts/migrate.ts",
    "test:watch": "APP_ENV=test varlock run -- bun test --watch",
    "validate-golden": "varlock run -- bun run src/test/validate-golden-dataset.ts",
    "typecheck": "tsc --noEmit",
    "test:functions": "APP_ENV=test varlock run -- bun test src/test/sql-functions.test.ts"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./job-client": "./src/job-client.ts",
    "./worker-client": "./src/worker-client.ts",
    "./queries": "./src/queries/index.ts",
    "./errors": "./src/errors.ts",
    "./schema": "./src/schema.ts",
    "./auth-schema": "./src/auth-schema.ts",
    "./sql": "./src/sql.ts",
    "./utils/api-keys": "./src/utils/api-keys.ts",
    "./utils/search-query": "./src/utils/search-query.ts",
    "./utils/health": "./src/utils/health.ts",
    "./utils/currency": "./src/utils/currency.ts",
    "./utils/tax": "./src/utils/tax.ts",
    "./utils/blocklist": "./src/utils/blocklist.ts",
    "./utils/invoice-recurring": "./src/utils/invoice-recurring.ts",
    "./listen": "./src/listen.ts",
    "./migrate": "./src/migrate.ts",
    "./vault": "./src/vault.ts"
  },
  "dependencies": {
    "@date-fns/tz": "catalog:",
    "@date-fns/utc": "^2.1.1",
    "@midday/banking": "workspace:*",
    "@midday/categories": "workspace:*",
    "@midday/encryption": "workspace:*",
    "@midday/invoice": "workspace:*",
    "@midday/logger": "workspace:*",
    "@midday/storage": "workspace:*",
    "@midday/utils": "workspace:*",
    "@sindresorhus/slugify": "catalog:",
    "@types/pg": "^8.20.0",
    "camelcase-keys": "catalog:",
    "drizzle-orm": "^0.45.1",
    "nanoid": "catalog:",
    "pg": "^8.20.0",
    "snakecase-keys": "^9.0.2",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  }
}
