# Env for @midday/worker. Shared keys are documented in the root .env.schema.
# Imports mirror the workspace dependencies that read env (keep in sync with package.json).
#
# @import(../../, pick=[NODE_ENV, APP_ENV, IMAP_MAILBOX, IMAP_POLL_INTERVAL, IMAP_PROCESSED_MAILBOX, IMAP_URL, FORTNOX_CLIENT_ID, FORTNOX_CLIENT_SECRET, FORTNOX_OAUTH_REDIRECT_URL, GIT_COMMIT_SHA, QUICKBOOKS_CLIENT_ID, QUICKBOOKS_CLIENT_SECRET, QUICKBOOKS_OAUTH_REDIRECT_URL, REDIS_QUEUE_URL, REDIS_URL, SENTRY_DSN, SLACK_ENCRYPTION_KEY, XERO_CLIENT_ID, XERO_CLIENT_SECRET, XERO_OAUTH_REDIRECT_URL])
# @import(../../packages/accounting/.env.schema)
# @import(../../packages/ai/.env.schema)
# @import(../../packages/app-store/.env.schema)
# @import(../../packages/banking/.env.schema)
