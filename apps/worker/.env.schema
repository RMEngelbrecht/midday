# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# HTTP port (health checks, job board).
# @type=port
PORT=8080

# Basic-auth credentials for the job board at /admin.
BOARD_USERNAME=
# @sensitive
BOARD_PASSWORD=

# Interval for logging DB pool stats (0 disables).
# @type=number
DB_POOL_STATS_INTERVAL_MS=60000

# Weekly AI insights generation and notification emails.
# @type=boolean
INSIGHTS_ENABLED=false
# @type=boolean
INSIGHTS_NOTIFICATIONS_ENABLED=false

# Kill switches for scheduled invoice jobs.
# @type=boolean
DISABLE_RECURRING_INVOICES=false
# @type=boolean
DISABLE_UPCOMING_NOTIFICATIONS=false
