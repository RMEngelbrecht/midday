# Env for @midday/api. Shared keys are documented in the root .env.schema.
# Imports mirror the workspace dependencies that read env (keep in sync with package.json).
#
# @import(../../, pick=[NODE_ENV, APP_ENV, ALLOWED_API_ORIGINS, API_URL, APP_URL, COMPOSIO_API_KEY, GIT_COMMIT_SHA, INBOX_WEBHOOK_PASSWORD, INBOX_WEBHOOK_USERNAME, INTERNAL_API_KEY, PLAID_CLIENT_ID, PLAID_ENVIRONMENT, PLAID_SECRET, RESEND_API_KEY, SENDBLUE_WEBHOOK_SECRET, SENTRY_DSN, SLACK_CLIENT_ID, SLACK_CLIENT_SECRET, SLACK_ENCRYPTION_KEY, SLACK_OAUTH_REDIRECT_URL, SLACK_SIGNING_SECRET, STRIPE_CONNECT_CLIENT_ID, STRIPE_CONNECT_WEBHOOK_SECRET, STRIPE_SECRET_KEY, SUPABASE_JWT_SECRET, SUPABASE_SECRET_KEY, SUPABASE_URL, TELEGRAM_BOT_USERNAME, TELEGRAM_WEBHOOK_SECRET_TOKEN, TELLER_SIGNING_SECRET, TRIGGER_SECRET_KEY, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN])
# @import(../../packages/accounting/.env.schema)
# @import(../../packages/app-store/.env.schema)
# @import(../../packages/banking/.env.schema)
# @import(../../packages/bot/.env.schema)
# @import(../../packages/cache/.env.schema)
# @import(../../packages/categories/.env.schema)
# @import(../../packages/db/.env.schema)
# @import(../../packages/documents/.env.schema)
# @import(../../packages/encryption/.env.schema)
# @import(../../packages/events/.env.schema)
# @import(../../packages/health/.env.schema)
# @import(../../packages/inbox/.env.schema)
# @import(../../packages/invoice/.env.schema)
# @import(../../packages/job-client/.env.schema)
# @import(../../packages/logger/.env.schema)
# @import(../../packages/notifications/.env.schema)
# @import(../../packages/supabase/.env.schema)
# @import(../../packages/utils/.env.schema)
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# HTTP port.
# @type=port
PORT=3003

# Requests per window for the REST API / MCP / chat endpoints.
# @type=number
API_RATE_LIMIT=1000
# Defaults to API_RATE_LIMIT.
# @type=number
MCP_API_RATE_LIMIT=
# @type=number
CHAT_RATE_LIMIT=100

# Interval for logging DB pool stats (0 disables).
# @type=number
DB_POOL_STATS_INTERVAL_MS=60000

# GitHub token for the desktop updater release proxy (higher rate limits).
# @sensitive
GITHUB_RELEASE_TOKEN=
