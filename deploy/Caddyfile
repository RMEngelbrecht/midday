# CADDY_SCHEME is empty for real domains (automatic HTTPS) and `http://` for
# local testing. APP_HOST and API_HOST default to app.$DOMAIN and api.$DOMAIN
# (see compose.yaml).
{$CADDY_SCHEME}{$APP_HOST} {
	encode zstd gzip
	reverse_proxy dashboard:3000
}

{$CADDY_SCHEME}{$API_HOST} {
	# flush_interval -1: do not buffer the /realtime SSE stream.
	reverse_proxy api:8080 {
		flush_interval -1
	}
}
