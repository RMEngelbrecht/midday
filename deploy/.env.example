# Midday deploy configuration. Copy to .env, then run ./generate-secrets.sh.
# Full reference: the root .env.schema (every key is documented there).

# --- Required ----------------------------------------------------------------
# Domain you serve Midday on: by default the dashboard is app.$DOMAIN and the
# API is api.$DOMAIN (both need DNS A/AAAA records pointing at this host; Caddy
# gets Let's Encrypt certificates automatically). They must share a parent
# domain because auth cookies are shared between them.
DOMAIN=example.com
APP_URL=https://app.example.com
API_URL=https://api.example.com

# Other hostnames: set both hosts and leave DOMAIN out. The dashboard may sit on
# the parent of the API host, e.g.:
#   APP_HOST=midday.example.com
#   API_HOST=api.midday.example.com
#   APP_URL=https://midday.example.com
#   API_URL=https://api.midday.example.com
# Public suffixes with two labels (example.co.uk) also need AUTH_COOKIE_DOMAIN.

# Local testing instead (no DNS, no TLS): lvh.me resolves to 127.0.0.1 and the
# two hosts share a parent domain. (app.localhost + api.localhost do NOT work:
# browsers will not share the session cookie between them.)
#   DOMAIN=lvh.me
#   CADDY_SCHEME=http://
#   HTTP_PORT=8080
#   APP_URL=http://app.lvh.me:8080
#   API_URL=http://api.lvh.me:8080
CADDY_SCHEME=
HTTP_PORT=80
HTTPS_PORT=443

# Image tag to run (see Releases) and the GHCR owner of the images.
MIDDAY_VERSION=latest
MIDDAY_OWNER=midday-app

# Generated by ./generate-secrets.sh (leave empty).
POSTGRES_PASSWORD=
MIDDAY_ENCRYPTION_KEY=
FILE_KEY_SECRET=
INVOICE_JWT_SECRET=
INTERNAL_API_KEY=
AUTH_SECRET=

# Who may sign up: first-user (default), invite-only, open.
# ALLOW_SIGNUP=first-user
# Emails that may sign up without an invite (exact addresses or @domain).
# SIGNUP_ALLOWED_EMAILS=@example.com, friend@other.org
# Instance admins besides the first account (can send instance invites).
# ADMIN_EMAILS=ops@example.com

# --- Mail ----------------------------------------------------------------------
# Without SMTP_URL, emails (sign-in codes, invites, invoices) are only logged.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Midday <noreply@example.com>"
# Profile `dev` (Mailpit, UI on http://localhost:8025):
# SMTP_URL=smtp://mailpit:1025
# MAILPIT_PORT=8025
# Inbound email via IMAP polling:
# IMAP_URL=imaps://user:password@imap.example.com:993
# INBOX_EMAIL_DOMAIN=inbox.example.com

# --- Storage ---------------------------------------------------------------------
# Default: local volume. Profile `s3` runs Garage; enable with:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://garage:3900
# S3_REGION=garage
# S3_BUCKET=midday
# S3_FORCE_PATH_STYLE=true
# (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / GARAGE_* are generated for you.)
# External store (AWS, R2, ...): set S3_* and leave the s3 profile off.
# S3_PUBLIC_ENDPOINT=
# S3_PUBLIC_URL=

# --- AI (optional) -----------------------------------------------------------------
# Profile `ai` runs Ollama:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL_CHAT=llama3.1
# AI_MODEL_VISION=qwen2.5vl:7b
# AI_EMBEDDING_PROVIDER=openai-compatible
# AI_EMBEDDING_BASE_URL=http://ollama:11434/v1
# AI_EMBEDDING_MODEL=nomic-embed-text
# Hosted provider instead:
# AI_PROVIDER=openai
# AI_API_KEY=

# --- Social sign-in (optional; redirect URL is API_URL/auth/callback/<provider>) -----
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# --- Banking (optional; see the root .env.schema for provider notes) -------------------
# SIMPLEFIN_ENABLED=true
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=production
# ENABLEBANKING_APPLICATION_ID=
# ENABLE_BANKING_KEY_CONTENT=
# TELLER_APPLICATION_ID=

# --- Integrations (optional) ---------------------------------------------------------------
# SLACK_CLIENT_ID=
# XERO_CLIENT_ID=
# QUICKBOOKS_CLIENT_ID=
# GMAIL_CLIENT_ID=
# OUTLOOK_CLIENT_ID=
# STRIPE_SECRET_KEY=

# --- Observability (optional) ----------------------------------------------------------------
# SENTRY_DSN=
# LOG_LEVEL=info
